<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.fresco.v1</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Fresco</name>
  <summary>Manage and auto-rotate your wallpapers</summary>
  <description>
    <p>
      Fresco keeps a folder of your favorite wallpapers and rotates your
      desktop background on a configurable schedule. Add images, crop them
      to fit your screen, and switch wallpapers manually or let Fresco do it
      for you.
    </p>
  </description>

  <developer id="io.github.snehal-reddy">
    <name>Snehal-Reddy</name>
  </developer>

  <url type="homepage">https://github.com/A5CENSION-SRT/Fresco</url>

  <translation type="gettext">fresco</translation>
  <launchable type="desktop-id">com.fresco.v1.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-09-08">
      <description translate="no">
        <p>Initial release.</p>
        <ul>
          <li>Managed wallpaper folder with add/remove/thumbnail grid</li>
          <li>Configurable rotation from 1 hour to 7 days via a systemd --user timer</li>
          <li>Manual rotate and interactive per-wallpaper selection</li>
          <li>Crop preview matched to your display's aspect ratio</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
